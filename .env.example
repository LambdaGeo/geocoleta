# Copie para `.env` (no diretório onde roda o geocoleta ou ao lado do .yaml do projeto).
# Só é necessário para fontes `tipo: epicollect` de projetos privados.
# O prefixo é o valor de `credenciais` na config (aqui: credenciais: MEUPROJ).
MEUPROJ_CLIENT_ID=
MEUPROJ_CLIENT_SECRET=

# Opcional: valores usados como ${VAR} na config
# PROJECT_MEUPROJ=slug-do-projeto
# FORM_MEUPROJ_REF=
