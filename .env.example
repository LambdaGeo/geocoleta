# Copy to `.env` (in the directory where fielddash runs or next to the project .yaml).
# Only required for `type: epicollect` sources with private projects.
# The prefix matches the `credentials` key in config (e.g., credentials: MYPROJ).
MYPROJ_CLIENT_ID=
MYPROJ_CLIENT_SECRET=

# Optional: values used as ${VAR} in config
# PROJECT_MYPROJ=project-slug
# FORM_MYPROJ_REF=
